{
  "name": "kodo-core",
  "version": "0.1.2",
  "author": "Shadow Lei",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "git@github.com:ShadowLei/kodo-core.git",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "LICENSE",
    "package.json",
    "README.md",
    "dist/"
  ],
  "scripts": {
    "build-dev": "bun build ./src/index.ts --outdir ./dist",
    "build:js": "bun build --production ./src/index.ts --outdir ./dist",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "bun run build:js && bun run build:types",
    "test:ns": "bun test ./test/orm/complex.test.ts",
    "test:db": "bun test ./test/db/db.test.ts",
    "test:ddb": "bun test ./test/ddb/*.test.ts",
    "test": "bun test ./test/**/*.test.ts"
  },
  "keywords": [
    "kodo-core",
    "nerual",
    "net",
    "connection"
  ],
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "meta-mapper": "^0.3.0"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}